{
  
  "$schema": "https://opencode.ai/config.json",


  "share": "disabled",

  "permission": {

    "*": "ask",

    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa*": "deny",
      "**/id_ed25519*": "deny",
      "**/.aws/credentials": "deny",
      "**/.npmrc": "deny",
      "**/.git-credentials": "deny"
    },


    "edit": "ask",


    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",


    "webfetch": "ask",
    "websearch": "ask",
    "codesearch": "ask",
    "task": "ask",
    "skill": "ask",

 
    "external_directory": "ask",
    "doom_loop": "ask",


    "bash": {
      "*": "ask",

     
      "ls *": "allow",
      "pwd": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch": "allow",

      
      "rm": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "unlink *": "deny",
      "shred *": "deny",
      "trash *": "deny",
      "find * -delete*": "deny",
      "find * -exec rm*": "deny",

    
      "del *": "deny",
      "erase *": "deny",
      "rd *": "deny",
      "Remove-Item *": "deny",
      "remove-item *": "deny",
      "ri *": "deny",

  
      "git rm *": "deny",
      "git clean *": "deny",
      "git reset --hard*": "deny",
      "git checkout -- *": "deny",
      "git restore *": "deny",
      "git branch -D *": "deny",
      "git branch -d *": "deny",
      "git stash drop*": "deny",
      "git stash clear*": "deny",

     
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push *": "ask",
      "git commit *": "ask",

    
      "sudo *": "deny",
      "su *": "deny",
      "chmod -R *": "deny",
      "chown -R *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "format *": "deny",

      "curl * | *": "deny",
      "wget * | *": "deny",
      "iwr * | iex*": "deny",

    
      "npm install*": "ask",
      "npm i *": "ask",
      "pip install*": "ask",
      "pip uninstall*": "deny",
      "npm uninstall*": "deny"
    }
  }
}
